# note: godot's build names linux libs *.windows.* (upstream naming bug)
cc_import(
    name = "libANGLE",
    static_library = "libANGLE.windows.x86_64.a",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "libGLES",
    static_library = "libGLES.windows.x86_64.a",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "libEGL",
    static_library = "libEGL.windows.x86_64.a",
    visibility = ["//visibility:public"],
)
